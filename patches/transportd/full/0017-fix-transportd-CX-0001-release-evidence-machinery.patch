+
+REPLAY_MANIFEST="$WORK/replay-manifest.yaml"
+cp "$REPO/replay/manifest.yaml" "$REPLAY_MANIFEST"
+BASE_COMMIT="$(sed -n 's/^base_commit: //p' "$REPLAY_MANIFEST" | head -1)"
