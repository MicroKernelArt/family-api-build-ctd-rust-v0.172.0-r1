+
+/// raw 形态（transportd R6）：与 [`run_with_request_telemetry`] 相同的
+/// per-attempt telemetry，但 retryable 状态按官方 policy 重试后，终态
+/// 响应（含非 2xx）原样返回并携带真实 attempt 次数。
+pub(crate) async fn run_with_request_telemetry_preserving_status<T, F, Fut>(
+    policy: RetryPolicy,
+    telemetry: Option<Arc<dyn RequestTelemetry>>,
+    make_request: impl FnMut() -> Request,
+    send: F,
+) -> Result<RawRetryOutcome<T>, TransportError>
+where
+    T: WithStatus,
+    F: Clone + Fn(Request) -> Fut,
+    Fut: Future<Output = Result<T, TransportError>>,
+{
+    run_with_retry_preserving_status(
+        policy,
+        make_request,
+        move |req, attempt| {
+            let telemetry = telemetry.clone();
+            let send = send.clone();
+            async move {
+                let start = Instant::now();
+                let result = send(req).await;
+                if let Some(t) = telemetry.as_ref() {
+                    let (status, err) = match &result {
+                        Ok(resp) => (Some(resp.status()), None),
+                        Err(err) => (http_status(err), Some(err)),
+                    };
+                    t.on_request(attempt, status, err, start.elapsed());
+                }
+                result
+            }
+        },
+        |value| Some(value.status()),
+    )
+    .await
+}
